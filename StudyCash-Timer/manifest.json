{
  "manifest_version": 3,
  "name": "StudyCash Timer",
  "version": "1.1.0",
  "description": "Автоматический учёт времени выполнения работ в Moodle",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dl.donnu.ru/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dl.donnu.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}